# Lien public de réservation Cal.com ou Calendly affiché dans la fenêtre « Demander une démonstration ».
# Laissez vide pour utiliser le formulaire de qualification intégré.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/immotopia/consultation-alliance-computer-consultants

# Webhook n8n qui reçoit les demandes du formulaire intégré (puis Airtable + e-mail de préparation).
N8N_WEBHOOK_URL=

# Assistant immotopIA : clé OpenRouter (https://openrouter.ai/keys) et modèle utilisé
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Module Événements (inscriptions) ---
# Fichier SQLite des événements et inscriptions. En production : un volume Docker (voir docker-compose.yml).
EVENTS_DB_PATH=./data/events.db
# Administration /admin/evenements : mot de passe (12 caractères minimum) et clé de signature des sessions (24 minimum, aléatoire).
# Laisser vide ferme l'administration. Générer la clé : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EVENTS_ADMIN_PASSWORD=
EVENTS_ADMIN_SECRET=
# E-mails transactionnels (confirmation, liste d'attente, annulation). Vide = aucun e-mail envoyé, inscriptions conservées.
# Option 1 : SMTP (Hostinger : smtp.hostinger.com, port 465 SSL ; EVENTS_EMAIL_FROM doit être l'adresse de la boîte EVENTS_SMTP_USER)
EVENTS_SMTP_HOST=
EVENTS_SMTP_PORT=465
EVENTS_SMTP_USER=
EVENTS_SMTP_PASSWORD=
# Option 2 : API Resend (utilisée seulement si le SMTP n'est pas configuré)
RESEND_API_KEY=
EVENTS_EMAIL_FROM=
EVENTS_EMAIL_REPLY_TO=

# Réception durable Mission Control via deux entrées N8N distinctes (serveur uniquement).
# N8N_WEBHOOK_URL reste le chemin de production, protégé par ce secret HeaderAuth.
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TEST_URL=
N8N_WEBHOOK_TEST_SECRET=
# Accès recette uniquement par header serveur x-mc-form-test ; jamais NEXT_PUBLIC.
FORM_RECIPE_AUTH_TOKEN=
MC_FORM_SOURCE_ID=site-form-immotopia-v1
