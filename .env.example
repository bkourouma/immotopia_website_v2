# Lien public de réservation Cal.com ou Calendly affiché dans la fenêtre « Demander une démonstration ».
# Laissez vide pour utiliser le formulaire de qualification intégré.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/immotopia/30min

# Webhook n8n qui reçoit les demandes du formulaire intégré (puis Airtable + e-mail de préparation).
N8N_WEBHOOK_URL=

# Assistant immotopIA : clé OpenRouter (https://openrouter.ai/keys) et modèle utilisé
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
