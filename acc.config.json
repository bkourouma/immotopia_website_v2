{
  "standardVersion": "0.1.0",
  "project": {
    "name": "site",
    "slug": "site",
    "description": "Site vitrine ImmoTopia (Next.js 16, bilingue FR/EN) : pages produit, tarifs, outils gratuits, assistant IA et demandes de démonstration.",
    "language": "fr"
  },
  "profiles": [
    "base",
    "node"
  ],
  "adapters": [
    "claude"
  ],
  "stack": {
    "packageManager": "npm",
    "workspaces": false,
    "typescript": true,
    "eslint": true,
    "prettier": false,
    "languages": [
      "javascript",
      "typescript"
    ]
  },
  "commands": {
    "install": "npm install",
    "dev": "npm run dev",
    "build": "npm run build",
    "typecheck": "npx tsc --noEmit",
    "lint": "npm run lint",
    "test": ""
  },
  "ports": {
    "web": 3000
  },
  "git": {
    "mainBranch": "master",
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "hooks": {
    "preCommit": [
      {
        "name": "typecheck",
        "command": "npx tsc --noEmit",
        "blocking": true,
        "whenStaged": [
          "**/*.ts",
          "**/*.tsx"
        ]
      },
      {
        "name": "lint",
        "command": "npm run lint",
        "blocking": false,
        "whenStaged": [
          "**/*.{js,jsx,mjs,cjs,ts,tsx}"
        ]
      },
      {
        "name": "comparatif-en",
        "command": "node scripts/check-comparatif-en.mjs",
        "blocking": true,
        "whenStaged": [
          "src/lib/comparatif-data.ts",
          "src/lib/comparatif-data.en.ts"
        ]
      }
    ]
  },
  "guard": {
    "protectedPaths": [
      "src",
      "public",
      "scripts",
      "deploy",
      "docs",
      ".claude",
      ".acc"
    ],
    "destructiveCommands": [
      {
        "pattern": "\\bDROP\\s+DATABASE\\b",
        "reason": "Suppression de base de données interdite aux agents."
      },
      {
        "pattern": "\\bssh\\s+(\\S+\\s+)*alliance\\b",
        "reason": "Commande sur le serveur de production (alliance) : déploiement ou intervention réservés à l'utilisateur."
      },
      {
        "pattern": "\\b(scp|rsync)\\b.*\\balliance:",
        "reason": "Envoi de fichiers vers le serveur de production (alliance) : déploiement réservé à l'utilisateur."
      }
    ]
  },
  "options": {
    "agentBus": true,
    "demoInstance": false
  },
  "demo": {}
}
