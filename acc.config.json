{
  "standardVersion": "0.1.0",
  "project": {
    "name": "site",
    "slug": "site",
    "description": "",
    "language": "fr"
  },
  "profiles": [
    "base",
    "node"
  ],
  "adapters": [
    "claude"
  ],
  "stack": {
    "packageManager": "npm",
    "workspaces": false,
    "typescript": true,
    "eslint": true,
    "prettier": false,
    "languages": [
      "javascript",
      "typescript"
    ]
  },
  "commands": {
    "install": "npm install",
    "dev": "npm run dev",
    "build": "npm run build",
    "typecheck": "npx tsc --noEmit",
    "lint": "npm run lint",
    "test": ""
  },
  "ports": {},
  "git": {
    "mainBranch": "master",
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "hooks": {
    "preCommit": [
      {
        "name": "typecheck",
        "command": "npx tsc --noEmit",
        "blocking": true,
        "whenStaged": [
          "**/*.ts",
          "**/*.tsx"
        ]
      },
      {
        "name": "lint",
        "command": "npm run lint",
        "blocking": false,
        "whenStaged": [
          "**/*.{js,jsx,mjs,cjs,ts,tsx}"
        ]
      }
    ]
  },
  "guard": {
    "protectedPaths": [
      "src",
      "public"
    ],
    "destructiveCommands": [
      {
        "pattern": "\\bDROP\\s+DATABASE\\b",
        "reason": "Suppression de base de données interdite aux agents."
      }
    ]
  },
  "options": {
    "agentBus": true,
    "demoInstance": false
  },
  "demo": {}
}
